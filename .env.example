# Copia este archivo a .env.local y completa los valores. Nunca lo subas a git.

# IA: Grok de xAI (sin esta clave la app funciona en modo demo)
XAI_API_KEY=

# Base de datos Neon (opcional: sin ella no se guardan borradores)
DATABASE_URL=

# Opcional: secreto para firmar tokens de generación (si falta, se deriva de XAI_API_KEY)
GENERATION_SECRET=

# Token de administrador para modificar ajustes (openssl rand -hex 32)
ADMIN_TOKEN=

# Generaciones reales por IP al día antes de pasar a modo demo
DAILY_GENERATION_LIMIT=3
